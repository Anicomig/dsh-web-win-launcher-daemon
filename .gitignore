# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vs/
.idea/
*.user
*.suo

# PowerShell: variable dumps and module caches
*.psd1.local
*.Variable.ps1

# Build / NuGet / VS outputs
bin/
obj/
*.nupkg
*.snupkg
packages/
*.userprefs

# Tray / daemon outputs
log/
*.log
DshLauncher/dist/
DshLauncher/DshLauncher.json
ConfigHost/defaults.json
ConfigHost/DshConfigHost.exe
ConfigHost/*.dll

# Prebuilt binaries ship in the GitHub Release zip, not in git
DshLauncherDaemon.exe

# Restore / housekeeping
_backup/
_preserved/
_ps2exe_dl/
.superpowers/

# Runtime-generated shortcuts (regenerated by Install.cmd)
DshLauncher.lnk
autostart/*.lnk

# The user's own runtime config (created on first Install)
DshLauncherDaemon_Config.ps1

# Release copy (regenerated by scripts/Sync-Release.ps1)
dsh-web-launcher-daemon/

# OS shell files
# Note: the project root's DshLauncher.lnk and autostart\*.lnk are runtime
# artifacts rebuilt by Install.cmd, so they're excluded above with explicit
# rules. Other .lnk files are not expected in the source tree; if any are
# added later, list them explicitly.
